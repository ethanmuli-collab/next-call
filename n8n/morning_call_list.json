{
  "name": "Next Call - morning call list",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "30 7 * * 0-4" } ] }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Sun-Thu 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5055/run",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Token", "value": "={{ $env.NEXT_CALL_WEBHOOK_TOKEN }}" } ] },
        "options": {
          "timeout": 300000,
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Retrain + rescore (POST /run)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Gate passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:5055/call-list",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "top", "value": "20" }, { "name": "format", "value": "text" } ] },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "GET /call-list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#admissions-calls", "mode": "name" },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Slack: today's list",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [880, -100],
      "credentials": { "slackApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Slack account" } }
    },
    {
      "parameters": {
        "fromEmail": "next-call@example.com",
        "toEmail": "admissions-rep@example.com",
        "subject": "Next Call - today's call list",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Email: today's list (alternative)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 60],
      "disabled": true
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#data-alerts", "mode": "name" },
        "text": "=:rotating_light: Next Call: the contract gate stopped this morning's run, no new call list.\n{{ $json.body.message }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Slack: gate failed alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [660, 120],
      "credentials": { "slackApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Sun-Thu 07:30": { "main": [ [ { "node": "Retrain + rescore (POST /run)", "type": "main", "index": 0 } ] ] },
    "Retrain + rescore (POST /run)": { "main": [ [ { "node": "Gate passed?", "type": "main", "index": 0 } ] ] },
    "Gate passed?": {
      "main": [
        [ { "node": "GET /call-list", "type": "main", "index": 0 } ],
        [ { "node": "Slack: gate failed alert", "type": "main", "index": 0 } ]
      ]
    },
    "GET /call-list": {
      "main": [ [
        { "node": "Slack: today's list", "type": "main", "index": 0 },
        { "node": "Email: today's list (alternative)", "type": "main", "index": 0 }
      ] ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Jerusalem" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
