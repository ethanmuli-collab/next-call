# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=
# Optional: model used by the agents and the call openers (default gpt-4o-mini)
NEXT_CALL_LLM_MODEL=gpt-4o-mini
# Optional: set to 1 to force offline mode (templates instead of the LLM)
NEXT_CALL_OFFLINE=
# Optional: token required by POST /run on the Flask webhook
WEBHOOK_TOKEN=
